# Required: your ElevenLabs API key (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=

# Needed for stock B-roll (when --broll is left out): https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Optional defaults (can also be passed as CLI flags)
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional: use an already-installed Chrome / chrome-headless-shell instead of
# letting Remotion download one on first render.
# REMOTION_BROWSER_EXECUTABLE=/path/to/chrome-headless-shell
